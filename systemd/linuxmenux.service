[Unit]
Description=LinuxMenux Monitor - Multi-Distro Web Dashboard & Terminal
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/usr/local/share/linuxmenux/backend
ExecStart=/usr/local/share/linuxmenux/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8008
Restart=always
RestartSec=5
Environment="PORT=8008"
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
